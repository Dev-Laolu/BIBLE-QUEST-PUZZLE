rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validations
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'level', 'xp', 'gamesPlayed', 'hintsUsed', 'lastActive'])
        && data.keys().size() == 6
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 25
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.xp is int && data.xp >= 0
        && data.gamesPlayed is int && data.gamesPlayed >= 0
        && data.hintsUsed is int && data.hintsUsed >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'username', 'score', 'level', 'hintsUsed', 'completedAt'])
        && data.keys().size() == 6
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 25
        && data.score is int && data.score >= 0
        && data.level is int && data.level >= 1
        && data.hintsUsed is int && data.hintsUsed >= 0;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'username', 'text', 'timestamp'])
        && data.keys().size() == 4
        && data.userId == request.auth.uid
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 25
        && data.text is string && data.text.size() >= 2 && data.text.size() <= 150;
    }

    // Match patterns
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().lastActive == request.time;
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().lastActive == request.time
                    && incoming().username == existing().username; // Username is immutable once set
      allow delete: if false; // Cannot delete profile
    }

    match /leaderboards/{dayId}/scores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId != null;
      allow create: if isSignedIn()
                    && scoreId == request.auth.uid
                    && isValidId(dayId)
                    && isValidId(scoreId)
                    && isValidLeaderboardEntry(incoming())
                    && incoming().completedAt == request.time;
      allow update: if isSignedIn()
                    && scoreId == request.auth.uid
                    && isValidId(dayId)
                    && isValidId(scoreId)
                    && isValidLeaderboardEntry(incoming())
                    && incoming().completedAt == request.time;
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId != null;
      allow create: if isSignedIn()
                    && isValidId(activityId)
                    && isValidActivity(incoming())
                    && incoming().timestamp == request.time;
      allow update, delete: if false; // Activities are write-once/immutable
    }
  }
}
